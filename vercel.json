{
  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "/api/p?id=:id"
    },
    {
      "source": "/v/:id",
      "destination": "/api/v?id=:id"
    },
    {
      "source": "/m/:id",
      "destination": "/api/m?id=:id"
    },
    {
      "source": "/e/:id",
      "destination": "/api/e?id=:id"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "wepawao-demo-afd4.vercel.app"
        }
      ],
      "destination": "https://www.wepawao.com/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "wao-demo-afd4.vercel.app"
        }
      ],
      "destination": "https://www.wepawao.com/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
